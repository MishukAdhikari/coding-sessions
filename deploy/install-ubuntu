#!/usr/bin/env bash
set -euo pipefail
umask 077

fail() { printf 'install-ubuntu: %s\n' "$*" >&2; exit 1; }
usage() {
  cat <<'USAGE'
Usage: sudo ./deploy/install-ubuntu --instance NAME --origin https://HOST --port PORT
       (--bun /path/to/reviewed/linux/bun | --bun-version VERSION --bun-sha256 SHA256)
       [--source /path/to/reviewed/checkout] [--daily-updates] [--codex-hooks]
       [--install-nginx] [--no-start] [--check] [--herdr]

Ubuntu 22.04/24.04/26.04, Debian 12/13. Creates a dedicated cs-NAME user; existing unmanaged users,
units, state or Codex policies are never taken over. --check validates inputs and
reports paths without writes. --no-start stages units for offline validation.
--herdr is opt-in: it installs pinned herdr 0.9.5 and selects it for new sessions.
Provider CLIs and authentication are separate operator steps. No sudo grant is
made to the service account. Nginx is opt-in; HTTPS must be provisioned afterward.
USAGE
}
source_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
instance='' origin='' port='' bun_path='' bun_version='' bun_sha256=''
daily=0 hooks=0 nginx=0 start=1 check=0 herdr=0
while (($#)); do
  case "$1" in
    --instance|--origin|--port|--bun|--bun-version|--bun-sha256|--source)
      (($# >= 2)) || fail "missing value for $1"
      case "$1" in
        --instance) instance=$2;; --origin) origin=$2;; --port) port=$2;;
        --bun) bun_path=$2;; --bun-version) bun_version=$2;; --bun-sha256) bun_sha256=$2;;
        --source) source_dir=$2;;
      esac
      shift 2;;
    --daily-updates) daily=1; shift;; --codex-hooks) hooks=1; shift;;
    --install-nginx) nginx=1; shift;; --no-start) start=0; shift;; --check) check=1; shift;;
    --herdr) herdr=1; shift;;
    --help|-h) usage; exit 0;; *) fail "unknown option: $1";;
  esac
done
[[ $instance =~ ^[a-z][a-z0-9-]{0,19}$ && $instance != *- ]] || fail 'instance must be 1-20 lowercase letters/digits/hyphens, starting with a letter and ending with letter/digit'
[[ $origin =~ ^https://([a-z0-9]([a-z0-9.-]*[a-z0-9])?)$ ]] || fail 'origin must be https://hostname without port, path, or credentials'
host=${BASH_REMATCH[1]}
[[ $host != *..* ]] || fail 'invalid hostname'
IFS=. read -r -a host_labels <<< "$host"
for label in "${host_labels[@]}"; do
  [[ $label =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || fail 'invalid hostname label'
done
((${#host} <= 253)) || fail 'hostname is too long'
[[ $port =~ ^[0-9]{4,5}$ ]] && ((10#$port >= 1024 && 10#$port <= 65535)) || fail 'port must be 1024-65535'
port=$((10#$port))
[[ -z $bun_path || ( -z $bun_version && -z $bun_sha256 ) ]] || fail 'choose --bun or version/checksum, not both'
if [[ -n $bun_path ]]; then
  [[ $bun_path = /* && -f $bun_path && -x $bun_path ]] || fail '--bun must name an absolute executable file'
else
  [[ $bun_version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && $bun_sha256 =~ ^[a-fA-F0-9]{64}$ ]] || fail 'provide --bun or an exact --bun-version and --bun-sha256 archive checksum'
fi
[[ -d $source_dir && -f $source_dir/bun.lock && -f $source_dir/server/index.ts && -d $source_dir/deploy/templates ]] || fail 'source must be a reviewed checkout containing bun.lock, server and deploy templates'
source_dir=$(cd -- "$source_dir" && pwd -P)
[[ $source_dir != / && $source_dir != /opt/coding-sessions* ]] || fail 'source must be a separate checkout, not an installed release'
service_user=cs-$instance
instance_home=/var/lib/coding-sessions/$instance
app_root=/opt/coding-sessions/$instance
config_root=/etc/coding-sessions
marker=$config_root/instances/$instance
if ((check)); then
  printf 'Validated: instance=%s user=%s home=%s app=%s origin=%s port=%s\n' "$instance" "$service_user" "$instance_home" "$app_root" "$origin" "$port"
  exit 0
fi
[[ $(id -u) = 0 ]] || fail 'run the installer as root; agents will run under the dedicated non-root account'
[[ $(uname -s) = Linux && -r /etc/os-release ]] || fail 'Ubuntu or Debian Linux required'
. /etc/os-release
case "${ID:-}:${VERSION_ID:-}" in
  ubuntu:22.04|ubuntu:24.04|ubuntu:26.04|debian:12|debian:13) ;;
  *) fail 'supported releases are Ubuntu 22.04, 24.04, 26.04 and Debian 12, 13' ;;
esac
case $(uname -m) in x86_64) bun_arch=x64;; aarch64|arm64) bun_arch=aarch64;; *) fail 'supported architectures are amd64 and arm64';; esac
for path in /opt/coding-sessions "$config_root" "$config_root/instances" "$config_root/credentials" "$config_root/credentials/$instance" "$app_root" "$app_root/releases" /var/lib/coding-sessions; do
  [[ ! -L $path ]] || fail "refusing symlink: $path"
  if [[ -e $path ]]; then
    [[ -d $path && $(stat -c %u "$path") = 0 ]] || fail "installer directory must be root-owned: $path"
    mode=$(stat -c %a "$path")
    (( (8#$mode & 0022) == 0 )) || fail "installer directory must not be group/world writable: $path"
  fi
done
[[ ! -L $instance_home ]] || fail 'instance home cannot be a symlink'
managed=0
if [[ -e $marker ]]; then
  [[ -f $marker && ! -L $marker && $(stat -c %u "$marker") = 0 ]] || fail 'invalid instance ownership marker'
  [[ $(cat "$marker") = "coding-sessions:$instance:$service_user:$instance_home" ]] || fail 'instance marker mismatch'
  managed=1
else
  ! getent passwd "$service_user" >/dev/null || fail 'service user already exists without installer ownership marker'
  ! getent group "$service_user" >/dev/null || fail 'service group already exists without installer ownership marker'
  [[ ! -e $instance_home && ! -e $app_root && ! -e $config_root/$instance.env && ! -e $config_root/credentials/$instance ]] || fail 'instance paths already exist without installer ownership marker'
  for unit in "coding-sessions@$instance.service" "coding-sessions-update@$instance.service" "coding-sessions-update@$instance.timer" "coding-sessions-app-update@$instance.service" "coding-sessions-app-update@$instance.timer"; do
    [[ ! -e /etc/systemd/system/$unit ]] || fail 'instance unit override already exists'
  done
fi
for unit in coding-sessions@.service coding-sessions-update@.service coding-sessions-update@.timer coding-sessions-app-update@.service coding-sessions-app-update@.timer; do
  target=/etc/systemd/system/$unit
  if [[ -e $target ]]; then
    [[ ! -L $target ]] && head -n 1 "$target" | grep -q '^# Managed by coding-sessions install-ubuntu\.' || fail "refusing unmanaged unit: $target"
    cmp -s "$source_dir/deploy/templates/$unit" "$target" || fail "shared unit differs: review and upgrade $target separately"
  fi
done
if ((hooks)) && [[ -e /etc/codex/requirements.toml ]]; then
  [[ ! -L /etc/codex/requirements.toml ]] && cmp -s "$source_dir/deploy/codex-requirements.toml" /etc/codex/requirements.toml || fail 'existing Codex requirements differ; review policy separately'
fi
if ((nginx)) && [[ -e /etc/nginx/sites-available/coding-sessions-$instance || -L /etc/nginx/sites-available/coding-sessions-$instance || -e /etc/nginx/sites-enabled/coding-sessions-$instance || -L /etc/nginx/sites-enabled/coding-sessions-$instance ]]; then
  fail 'nginx site already exists; preserve it and omit --install-nginx on rerun'
fi
if ((managed)); then
  [[ -f $config_root/$instance.env && ! -L $config_root/$instance.env && $(stat -c %u "$config_root/$instance.env") = 0 ]] || fail 'managed environment file is missing or unsafe'
  grep -qx "ORIGIN=$origin" "$config_root/$instance.env" && grep -qx "PORT=$port" "$config_root/$instance.env" || fail 'existing origin or port differs; edit instance configuration deliberately, then rerun'
  for unit in "coding-sessions@$instance.service" "coding-sessions-update@$instance.service" "coding-sessions-update@$instance.timer" "coding-sessions-app-update@$instance.service" "coding-sessions-app-update@$instance.timer"; do
    [[ ! -e /etc/systemd/system/$unit && ! -d /etc/systemd/system/$unit.d ]] || fail "instance unit override exists: $unit; review separately"
  done
  entry=$(getent passwd "$service_user") || fail 'managed service account is missing'
  [[ $(cut -d: -f6 <<< "$entry") = "$instance_home" && $(cut -d: -f3 <<< "$entry") != 0 ]] || fail 'managed service account changed'
  [[ $(id -nG "$service_user") = "$service_user" ]] || fail 'service account has extra groups; review them before continuing'
fi
if ((start)); then [[ -d /run/systemd/system ]] || fail 'systemd is not running; use --no-start for image preparation'; fi
for existing in "$config_root"/*.env; do
  [[ -f $existing && $existing != "$config_root/$instance.env" ]] || continue
  ! grep -qx "PORT=$port" "$existing" || fail 'port is assigned to another instance'
done

export DEBIAN_FRONTEND=noninteractive
# GitHub CLI from GitHub's signed repository: its maintainers mark the distribution
# packages in Ubuntu 24.04/26.04 and Debian 13 as broken against current GitHub APIs.
if [[ ! -f /etc/apt/sources.list.d/github-cli.list ]]; then
  install -d -m 0755 /etc/apt/keyrings
  curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 -o /etc/apt/keyrings/githubcli-archive-keyring.gpg https://cli.github.com/packages/githubcli-archive-keyring.gpg
  chmod 0644 /etc/apt/keyrings/githubcli-archive-keyring.gpg
  printf 'deb [arch=%s signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main\n' "$(dpkg --print-architecture)" > /etc/apt/sources.list.d/github-cli.list
fi
apt-get update
apt-get install -y --no-install-recommends ca-certificates curl unzip git gh rsync openssh-client screen procps lsof sudo bash coreutils grep sed libc-bin openssl systemd util-linux
# The web terminal needs ttyd 1.7+ (--writable). Debian 12 has no package and Ubuntu 22.04's
# is 1.6, so those get the pinned upstream build, checked against its published digest.
ttyd_ok() { [[ -n $1 ]] && printf '1.7.0\n%s\n' "$1" | sort -VC; }
ttyd_have=$(ttyd --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1 || true)
if ! ttyd_ok "$ttyd_have"; then
  ttyd_candidate=$(apt-cache policy ttyd 2>/dev/null | sed -n 's/^ *Candidate: //p' | grep -oE '^[0-9]+\.[0-9]+\.[0-9]+' || true)
  if ttyd_ok "$ttyd_candidate"; then
    apt-get install -y --no-install-recommends ttyd
  else
    case $bun_arch in
      x64) ttyd_file=ttyd.x86_64 ttyd_sum=8a217c968aba172e0dbf3f34447218dc015bc4d5e59bf51db2f2cd12b7be4f55;;
      *) ttyd_file=ttyd.aarch64 ttyd_sum=b38acadd89d1d396a0f5649aa52c539edbad07f4bc7348b27b4f4b7219dd4165;;
    esac
    ttyd_tmp=$(mktemp)
    curl --fail --location --proto '=https' --tlsv1.2 -o "$ttyd_tmp" "https://github.com/tsl0922/ttyd/releases/download/1.7.7/$ttyd_file"
    printf '%s  %s\n' "$ttyd_sum" "$ttyd_tmp" | sha256sum --check --status || { rm -f "$ttyd_tmp"; fail 'ttyd checksum mismatch'; }
    install -o root -g root -m 0755 "$ttyd_tmp" /usr/local/bin/ttyd
    rm -f "$ttyd_tmp"
  fi
fi
# Opt-in herdr multiplexer: pinned upstream build, checked against its digest.
if ((herdr)) && [[ $(/usr/local/bin/herdr --version 2>/dev/null || true) != 'herdr 0.9.5' ]]; then
  case $bun_arch in
    x64) herdr_file=herdr-linux-x86_64 herdr_sum=14d9e8bc8b4a9e0118d77c32266f76d461f09b40342eb23752960bd89f59929d;;
    *) herdr_file=herdr-linux-aarch64 herdr_sum=17d7536f2da50859523680ef279dffcac8e4a235f4e46fe8da6c2ec44141897c;;
  esac
  herdr_tmp=$(mktemp)
  curl --fail --location --proto '=https' --tlsv1.2 -o "$herdr_tmp" "https://github.com/herdrdev/herdr/releases/download/v0.9.5/$herdr_file"
  printf '%s  %s\n' "$herdr_sum" "$herdr_tmp" | sha256sum --check --status || { rm -f "$herdr_tmp"; fail 'herdr checksum mismatch'; }
  install -o root -g root -m 0755 "$herdr_tmp" /usr/local/bin/herdr
  rm -f "$herdr_tmp"
fi
if ((nginx)); then apt-get install -y nginx certbot python3-certbot-nginx; fi
stage=$(mktemp -d /tmp/cs-install.XXXXXXXX)
trap 'rm -rf -- "$stage"' EXIT
if [[ -z $bun_path ]]; then
  archive=$stage/bun.zip
  curl --fail --location --proto '=https' --tlsv1.2 "https://github.com/oven-sh/bun/releases/download/bun-v$bun_version/bun-linux-$bun_arch.zip" -o "$archive"
  printf '%s  %s\n' "$bun_sha256" "$archive" | sha256sum --check --status || fail 'Bun archive checksum mismatch'
  unzip -q "$archive" -d "$stage/bun"
  bun_path=$stage/bun/bun-linux-$bun_arch/bun
fi
"$bun_path" --version >/dev/null || fail 'Bun does not run on this host'
mkdir "$stage/source"
source_items=(server public scripts deploy package.json bun.lock)
for document in LICENSE README.md SECURITY.md THIRD_PARTY_NOTICES.md docs/security.md docs/mcp.md docs/local-dev.md; do [[ ! -f $source_dir/$document ]] || source_items+=("$document"); done
tar -C "$source_dir" --exclude=node_modules --exclude=data --exclude='.env*' --exclude='*.log' --exclude='*.db' --exclude='*.db-*' --exclude=__pycache__ --exclude='*.pyc' -cf "$stage/source.tar" "${source_items[@]}"
tar -C "$stage/source" -xf "$stage/source.tar"
[[ -z $(find "$stage/source" -type l -print -quit) ]] || fail 'reviewed source must not contain symlinks into mutable locations'
mkdir -p "$stage/source/bin"
install -m 0755 "$bun_path" "$stage/source/bin/bun"
(cd "$stage/source" && ./bin/bun install --frozen-lockfile --ignore-scripts)
# Record what this release was built from, so the daily updater knows when it is current.
if commit=$(git -C "$source_dir" rev-parse --verify -q 'HEAD^{commit}' 2>/dev/null); then
  printf '%s\n' "$commit" > "$stage/source/.source-commit"
  version=$(git -C "$source_dir" describe --tags --exact-match 2>/dev/null || printf 'commit-%s' "${commit:0:12}")
  printf '%s\n' "$version" > "$stage/source/.source-version"
fi
release=$(date -u +%Y%m%dT%H%M%SZ)-$(sha256sum "$stage/source.tar" | cut -c1-12)
install -d -o root -g root -m 0755 /opt/coding-sessions "$app_root" "$app_root/releases"
[[ ! -e $app_root/releases/$release ]] || release=$release-$$
cp -a "$stage/source" "$app_root/releases/$release"
chown -R root:root "$app_root/releases/$release"
chmod -R go-w "$app_root/releases/$release"
chmod 0755 "$app_root/releases/$release"
chmod 0755 "$app_root/releases/$release/deploy/update-coding-clis" "$app_root/releases/$release/deploy/install-provider-clis" "$app_root/releases/$release/deploy/update-app"
# Package directories must be readable by the service account despite installer umask.
find "$app_root/releases/$release" -type d -exec chmod a+rx {} +
find "$app_root/releases/$release" -type f -exec chmod a+r {} +

install -d -o root -g root -m 0755 "$config_root" "$config_root/instances" /var/lib/coding-sessions
install -d -o root -g root -m 0700 "$config_root/credentials" "$config_root/credentials/$instance"
if ((!managed)); then
  useradd --system --user-group --home-dir "$instance_home" --shell /bin/bash "$service_user"
  install -d -o "$service_user" -g "$service_user" -m 0700 "$instance_home"
  printf 'coding-sessions:%s:%s:%s\n' "$instance" "$service_user" "$instance_home" > "$marker"
  chmod 0600 "$marker"
fi
for directory in data run run/screen .config .local .local/bin .local/state; do
  [[ ! -L $instance_home/$directory ]] || fail "refusing state symlink: $directory"
  runuser -u "$service_user" -- install -d -m 0700 "$instance_home/$directory"
done
for credential in admin-password token-encryption-key; do
  path=$config_root/credentials/$instance/$credential
  [[ ! -L $path ]] || fail 'credential path is a symlink'
  if [[ ! -e $path ]]; then openssl rand -base64 32 > "$path"; fi
  [[ -f $path && $(stat -c %u "$path") = 0 ]] || fail 'credential must be a root-owned regular file'
  chmod 0600 "$path"
done
if [[ ! -e $instance_home/.screenrc ]]; then
  printf 'termcapinfo xterm*|xterms|xs|rxvt ti@:te@\ndefscrollback 10000\ndefutf8 on\n' | runuser -u "$service_user" -- tee "$instance_home/.screenrc" >/dev/null
fi
mux=screen
((herdr)) && mux=herdr
if [[ ! -e $config_root/$instance.env ]]; then
  cat > "$config_root/$instance.env" <<ENV
HOME=$instance_home
PATH=$instance_home/.local/bin:/opt/coding-sessions/$instance/current/bin:/usr/local/bin:/usr/bin:/bin
PORT=$port
ORIGIN=$origin
RP_ID=$host
CS_DATA_DIR=$instance_home/data
CS_RUNTIME_DIR=$instance_home/run
SCREENDIR=$instance_home/run/screen
CS_AGENT_PERMISSIONS=standard
CS_CHILD_ENV=filtered
CS_TRUST_PROXY=1
CS_MUX=$mux
CS_CLI_UPDATE_TIMER=coding-sessions-update@$instance.timer
CS_CLI_UPDATE_SERVICE=coding-sessions-update@$instance.service
CS_CLI_UPDATE_CONTROL=0
CS_APP_UPDATE_STATUS=/var/lib/coding-sessions/app-updates/$instance.json
CS_APP_UPDATE_CHANNEL=releases
ENV
  chmod 0600 "$config_root/$instance.env"
else
  [[ ! -L $config_root/$instance.env && $(stat -c %u "$config_root/$instance.env") = 0 ]] || fail 'environment file must be root-owned and not a symlink'
  chmod 0600 "$config_root/$instance.env"
  grep -qx "ORIGIN=$origin" "$config_root/$instance.env" && grep -qx "PORT=$port" "$config_root/$instance.env" || fail 'existing origin or port differs; edit instance configuration deliberately, then rerun'
  grep -q '^CS_APP_UPDATE_STATUS=' "$config_root/$instance.env" || printf 'CS_APP_UPDATE_STATUS=/var/lib/coding-sessions/app-updates/%s.json\nCS_APP_UPDATE_CHANNEL=releases\n' "$instance" >> "$config_root/$instance.env"
  if ((herdr)); then printf 'herdr installed; to use it for new sessions set CS_MUX=herdr in %s and restart coding-sessions@%s\n' "$config_root/$instance.env" "$instance"; fi
fi
for unit in coding-sessions@.service coding-sessions-update@.service coding-sessions-update@.timer coding-sessions-app-update@.service coding-sessions-app-update@.timer; do
  install -o root -g root -m 0644 "$source_dir/deploy/templates/$unit" /etc/systemd/system/
done
if ((hooks)); then
  for directory in /etc/codex /usr/local/lib/coding-sessions /usr/local/lib/coding-sessions/bin /usr/local/lib/coding-sessions/codex-hooks; do
    [[ ! -L $directory ]] || fail "refusing managed hook symlink: $directory"
    install -d -o root -g root -m 0755 "$directory"
  done
  for target in /usr/local/lib/coding-sessions/bin/bun /usr/local/lib/coding-sessions/codex-hooks/codex-hook.ts /usr/local/lib/coding-sessions/codex-hooks/codex-state.ts; do [[ ! -L $target ]] || fail "refusing hook symlink: $target"; done
  install -o root -g root -m 0755 "$bun_path" /usr/local/lib/coding-sessions/bin/bun
  install -o root -g root -m 0644 "$source_dir/server/codex-hook.ts" "$source_dir/server/codex-state.ts" /usr/local/lib/coding-sessions/codex-hooks/
  install -o root -g root -m 0644 "$source_dir/deploy/codex-requirements.toml" /etc/codex/requirements.toml
fi
ln -s "$app_root/releases/$release" "$app_root/current.new"
mv -Tf "$app_root/current.new" "$app_root/current"
if ((nginx)); then
  sed -e "s/@INSTANCE@/$instance/g" -e "s/@HOST@/$host/g" -e "s/@PORT@/$port/g" "$source_dir/deploy/templates/nginx.conf" > "/etc/nginx/sites-available/coding-sessions-$instance"
  chmod 0644 "/etc/nginx/sites-available/coding-sessions-$instance"
  ln -s "/etc/nginx/sites-available/coding-sessions-$instance" "/etc/nginx/sites-enabled/coding-sessions-$instance"
  nginx -t
  if ((start)); then systemctl reload nginx; fi
fi
systemd-analyze verify "coding-sessions@$instance.service" "coding-sessions-update@$instance.service" "coding-sessions-update@$instance.timer" "coding-sessions-app-update@$instance.service" "coding-sessions-app-update@$instance.timer"
credential_note="Credentials remain root-only in $config_root/credentials/$instance/."
if ((start)); then
  systemctl daemon-reload
  # Check that systemd can hand this service its credentials. Some hosts can't (LXC and
  # other container-based VPSes); there the service gets owner-only copies in its own
  # home instead, as the Docker image does. Only digests are compared, never printed.
  probe=$config_root/credentials/$instance/token-encryption-key
  want=$(sha256sum < "$probe" | cut -d' ' -f1)
  got=''
  for _ in 1 2 3; do
    got=$(systemd-run --wait --pipe --quiet --collect -p User="$service_user" -p LoadCredential=probe:"$probe" \
      sh -c 'sha256sum < "$CREDENTIALS_DIRECTORY/probe"' 2>/dev/null | cut -d' ' -f1 || true)
    [[ $got = "$want" ]] && break
    sleep 1
  done
  fallback=$instance_home/credentials
  env_file=$config_root/$instance.env
  if [[ $got != "$want" ]]; then
    printf 'Note: systemd on this host cannot pass credentials to services; giving the service owner-only copies in %s.\n' "$fallback"
    # The home belongs to the service account, so the account writes there itself:
    # root only opens the source files and never follows a path the account controls.
    runuser -u "$service_user" -- install -d -m 0700 "$fallback"
    for credential in admin-password token-encryption-key; do
      runuser -u "$service_user" -- sh -c 'umask 077; d=$1; f=$2; [ -d "$d" ] && [ ! -L "$d" ] || exit 1; cat > "$d/.$f.new" && mv -f "$d/.$f.new" "$d/$f"' sh "$fallback" "$credential" \
        < "$config_root/credentials/$instance/$credential" || fail 'could not write the credential fallback'
    done
    grep -q '^CS_TOKEN_KEY_FILE=' "$env_file" \
      || printf 'CS_TOKEN_KEY_FILE=%s/token-encryption-key\nCS_ADMIN_PASSWORD_FILE=%s/admin-password\n' "$fallback" "$fallback" >> "$env_file"
    credential_note="systemd here can't pass credentials to services, so the service reads owner-only copies in $fallback."
  elif grep -qx "CS_TOKEN_KEY_FILE=$fallback/token-encryption-key" "$env_file"; then
    # systemd works now: go back to root-only credentials and remove the copies.
    sed -i "\|^CS_TOKEN_KEY_FILE=$fallback/token-encryption-key\$|d; \|^CS_ADMIN_PASSWORD_FILE=$fallback/admin-password\$|d" "$env_file"
    runuser -u "$service_user" -- rm -f -- "$fallback/token-encryption-key" "$fallback/admin-password"
    printf 'systemd can pass credentials here now; removed the owner-only copies.\n'
  fi
  systemctl enable "coding-sessions@$instance.service"
  systemctl restart "coding-sessions@$instance.service"
  healthy=0
  for _ in {1..10}; do
    if systemctl is-active --quiet "coding-sessions@$instance.service" && curl --fail --silent --max-time 2 --output /dev/null "http://127.0.0.1:$port/"; then healthy=1; break; fi
    sleep 1
  done
  ((healthy)) || fail "service did not become healthy; inspect coding-sessions@$instance.service privately (no journal contents printed)"
  if ((daily)); then systemctl enable --now "coding-sessions-update@$instance.timer"; fi
  # Checks daily but changes nothing until the owner turns on automatic updates in Settings.
  systemctl enable --now "coding-sessions-app-update@$instance.timer"
fi
printf 'Installed %s. %s\n' "$instance" "${credential_note:-Credentials remain root-only in $config_root/credentials/$instance/.}"
[[ ${CS_INSTALL_CALLER:-} = cli ]] || printf 'Complete HTTPS before browser use: sudo certbot --nginx -d %s\n' "$host"
