# Managed by coding-sessions install-ubuntu. Root updater; a no-op unless the instance owner turns on automatic updates.
[Unit]
Description=Update the Coding Sessions app (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/coding-sessions/%i/current/deploy/update-app %i
TimeoutStartSec=30min
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
