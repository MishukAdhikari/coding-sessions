# Managed by coding-sessions install-ubuntu. Root-owned application, isolated instance home.
[Unit]
Description=Coding Sessions (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cs-%i
Group=cs-%i
WorkingDirectory=/opt/coding-sessions/%i/current
EnvironmentFile=/etc/coding-sessions/%i.env
LoadCredential=admin-password:/etc/coding-sessions/credentials/%i/admin-password
LoadCredential=token-encryption-key:/etc/coding-sessions/credentials/%i/token-encryption-key
ExecStart=/opt/coding-sessions/%i/current/bin/bun server/index.ts
Restart=on-failure
RestartSec=3
KillMode=process
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/coding-sessions/%i
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
