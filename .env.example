# Non-secret configuration only. Replace example host and absolute paths.
ORIGIN=https://sessions.example.com
RP_ID=sessions.example.com
PORT=9121
XCS_DATA_DIR=/var/lib/xcloud-sessions/example/data
XCS_AGENT_PERMISSIONS=standard
XCS_CHILD_ENV=filtered

# Enable only behind a trusted proxy that overwrites forwarded client headers.
# Keep the application port inaccessible to untrusted clients.
# XCS_TRUST_PROXY=1

# Optional GitHub defaults; leave unset for no default repository/owner filter.
# XCS_DEFAULT_REPO=example-owner/example-repository
# XCS_GITHUB_OWNERS=example-owner

# Optional protected secret FILE paths for non-systemd deployments.
# Files must be regular, not symlinks, and inaccessible to group/other users.
# The token key is canonical base64 encoding of exactly 32 random bytes.
# Do not put the password or key contents in this file.
# XCS_TOKEN_KEY_FILE=/etc/xcloud-sessions/credentials/example/token-encryption-key
# XCS_ADMIN_PASSWORD_FILE=/etc/xcloud-sessions/credentials/example/admin-password
# The installer instead supplies these through systemd LoadCredential.

# Optional claude.ai browser login email; no fallback account is assumed.
# CAI_EMAIL=operator@example.com
