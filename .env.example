# Non-secret configuration only. Replace example host and absolute paths.
# CS_DEFAULT_REPO, CS_GITHUB_OWNERS, CAI_EMAIL, CS_TERM_MOUSE, CS_AGENT_PERMISSIONS and
# CS_APP_UPDATE_CHANNEL are starting values: Settings → Server settings can override them.
ORIGIN=https://sessions.example.com
RP_ID=sessions.example.com
PORT=9121
CS_DATA_DIR=/var/lib/coding-sessions/example/data
CS_AGENT_PERMISSIONS=standard
CS_CHILD_ENV=filtered

# Enable only behind a trusted proxy that overwrites forwarded client headers.
# Keep the application port inaccessible to untrusted clients.
# CS_TRUST_PROXY=1

# Optional last-activity signal for an idle check on this machine: GET
# http://127.0.0.1:PORT/activity, no sign-in. Always bound to 127.0.0.1; never proxy it.
# CS_ACTIVITY_PORT=9131

# Optional: after the machine reboots (or a sandbox wakes), resume the sessions the reboot
# ended, under the same names, without anyone opening the app. Linux only.
# CS_RESUME_AFTER_BOOT=1

# Optional GitHub defaults; leave unset for no default repository/owner filter.
# CS_DEFAULT_REPO=example-owner/example-repository
# CS_GITHUB_OWNERS=example-owner

# Optional protected secret FILE paths for non-systemd deployments.
# Files must be regular, not symlinks, and inaccessible to group/other users.
# The token key is canonical base64 encoding of exactly 32 random bytes.
# Do not put the password or key contents in this file.
# CS_TOKEN_KEY_FILE=/etc/coding-sessions/credentials/example/token-encryption-key
# CS_ADMIN_PASSWORD_FILE=/etc/coding-sessions/credentials/example/admin-password
# The installer instead supplies these through systemd LoadCredential.

# Optional claude.ai browser login email; no fallback account is assumed.
# CAI_EMAIL=operator@example.com
